{
  "name": "kin-homecare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "migrate": "npm run migrate --workspace server",
    "reset:data": "npm run reset:data --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
