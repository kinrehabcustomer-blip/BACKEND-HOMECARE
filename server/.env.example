PORT=4000
CORS_ORIGIN=http://localhost:5173

# connection string ของ Neon/Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# กุญแจเซ็น session token — ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ส่ง OTP รีเซ็ตรหัสผ่านทางอีเมล — ถ้าเว้นว่าง OTP จะถูกพิมพ์ลง console แทน (ใช้ได้เฉพาะตอน dev)
# Gmail: เปิด 2-Step Verification แล้วสร้าง App Password ที่ myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kinrehabilitation.team@gmail.com
SMTP_PASS=
SMTP_FROM=KIN Homecare <kinrehabilitation.team@gmail.com>

# Google Maps — key ฝั่ง "server" ใช้เรียก Geocoding API (ที่อยู่ -> พิกัด) จาก serverless เท่านั้น
# แนะนำให้จำกัดด้วย API restriction = Geocoding API และ (ถ้าตั้งได้) IP ของ Vercel — ห้าม commit ค่าจริง
# เว้นว่าง = ปิดการ geocode อัตโนมัติ (ยังกรอกพิกัด lat/lng มือได้ตามปกติ)
# หมายเหตุ: key ฝั่งเบราว์เซอร์ (แผนที่/autocomplete) เป็นคนละใบ อยู่ที่ client/.env (VITE_GOOGLE_MAPS_KEY)
GOOGLE_MAPS_SERVER_KEY=
